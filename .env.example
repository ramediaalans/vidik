# Шаблон конфига. Скопировать в .env и заполнить. Сам .env в .gitignore.

# --- Только для скриптов tools/ (в браузер не попадают) ---
YT_API_KEY=

BALANCER1_NAME=
BALANCER1_TOKEN=
BALANCER1_BASE=
BALANCER2_NAME=
BALANCER2_TOKEN=
BALANCER2_BASE=

VIBIX_EMAIL=
VIBIX_PASSWORD=

# --- Публичные: уходят в клиентский бандл, секреты сюда не класть ---
# id паблишера балансера для тега <ins data-publisher-id>
VITE_VIBIX_PUBLISHER_ID=
# Необязательно: адреса SDK через запятую (по порядку приоритета).
# Если пусто — берутся значения по умолчанию из VibixPlayer.tsx.
VITE_VIBIX_SDK_SOURCES=
# Внешний хост для тяжёлого медиа (music/, roms/, cores/), например R2:
# VITE_MEDIA_BASE=https://media.art-ai.studio
# Пусто — файлы берутся из app/public/, как при локальной разработке.
VITE_MEDIA_BASE=
