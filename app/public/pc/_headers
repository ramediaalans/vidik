# Заголовки только для раздела /pc/*. Основной сайт их не получает.
# COOP/COEP нужны многопоточным сборкам (Heroes 3 / VCMI). credentialless не ломает сторонние ресурсы в Chromium.
/pc/*
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'self'; object-src 'none'

/pc/heroes3/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/pc/engines/*
  Cache-Control: public, max-age=31536000, immutable

/pc/games/*
  Cache-Control: public, max-age=31536000, immutable
